<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Venom.Client</AssemblyName>
    <RootNamespace>Venom.Client</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>BensBurnedWaffles</Authors>
    <Company>BensBurnedWaffles</Company>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ReferenceDir Condition="'$(ReferenceDir)' == ''">$(MSBuildThisFileDirectory)refs</ReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="HarmonyX" Version="2.16.1" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <Reference Include="Assembly-CSharp"><HintPath>$(ReferenceDir)/hollowed.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(ReferenceDir)/Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ReferenceDir)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
